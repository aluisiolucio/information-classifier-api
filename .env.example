# Ambiente local — copie para .env e ajuste conforme necessário.
ENVIRONMENT=dev
LOG_LEVEL=INFO
API_PORT=8000

POSTGRES_DB=information_classifier_api
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-local-only
# Usado pela aplicação fora do Compose:
DATABASE_URL=postgresql+psycopg://app:change-me-local-only@localhost:5432/information_classifier_api
REDIS_URL=redis://localhost:6379/0

MINIO_ROOT_USER=change-me-local-only
MINIO_ROOT_PASSWORD=change-this-local-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=information-classifier-api
S3_ACCESS_KEY=change-me-local-only
S3_SECRET_KEY=change-this-local-secret
S3_REGION=us-east-1
STORAGE_BACKEND=s3

# LLM: heuristic (determinístico, sem rede) ou openai (HTTP compatível com
# OpenAI, incluindo o Ollama do Compose). O Ollama ignora a chave, mas a
# validação da aplicação exige um valor não vazio.
LLM_PROVIDER=openai
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:1b
# Dentro do Compose o host é o serviço "ollama". Fora dele, use
# http://localhost:11434/v1.
LLM_BASE_URL=http://ollama:11434/v1
# CPU pode levar mais tempo no primeiro carregamento do modelo.
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=1

# Ollama no Compose. A porta 11435 evita conflito com um Ollama no host.
OLLAMA_HOST_PORT=11435
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=5m

PROMPT_MAX_CHARS=24000
MAX_UPLOAD_BYTES=52428800
MAX_TEXT_CHARS=500000
MAX_EXTRACTED_CHARS=500000
MAX_RULE_PROMPT_CHARS=20000

WEB_FETCH_TIMEOUT_SECONDS=30
WEB_FETCH_MAX_RESPONSE_BYTES=5242880
WEB_FETCH_USER_AGENT=InformationClassifierBot/1.0
WEB_FETCH_MAX_REDIRECTS=5
ALLOWED_URL_PORTS=[80,443]

# Áudio/vídeo: modelo Whisper (tiny, base, small, medium, large, turbo) e
# idioma ISO-639-1. Idioma vazio detecta automaticamente.
ASR_MODEL=small
ASR_LANGUAGE=

CELERY_TASK_MAX_RETRIES=3
CELERY_RETRY_BACKOFF_SECONDS=5
ANALYSIS_SOFT_TIME_LIMIT_SECONDS=900
